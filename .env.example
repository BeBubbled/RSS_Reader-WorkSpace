# Public endpoint exposed by Caddy.
APP_PORT=8080
APP_ENVIRONMENT=development
APP_ALLOWED_ORIGINS=

# Change these before exposing the service outside a trusted development network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying
APP_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
