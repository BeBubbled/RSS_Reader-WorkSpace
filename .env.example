APP_ENCRYPTION_KEY=lEgmaNLZbLEptAO6glxBrO5g2mES6wB6yMyGH0MnbE=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_SECONDS=604800

POSTGRES_DB=rss_ai
POSTGRES_USER=rss_ai
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432
REDIS_PORT=6379
