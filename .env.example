# Public endpoint exposed by Caddy.
APP_PORT=8080
APP_ENVIRONMENT=development
APP_ALLOWED_ORIGINS=

# Change these before exposing the service outside a trusted development network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying
APP_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_ENCRYPTION_KEY=replace-with-a-fernet-key-generated-for-this-deployment
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE_SECONDS=604800

POSTGRES_DB=rss_ai
POSTGRES_USER=rss_ai
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432
REDIS_PORT=6379
